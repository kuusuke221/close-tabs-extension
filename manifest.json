{
  "manifest_version": 3,
  "name": "ピン留め以外をすべて閉じる",
  "version": "1.0",
  "description": "現在開いているウィンドウで、ピン留め（固定）されておらず、かつグループ化されていないタブをすべて一括で閉じます。",
  "permissions": [
    "tabs",
    "contextMenus"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "ピン留め以外のタブを閉じる",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}